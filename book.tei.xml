/d1/Harvard_drs_430993133_%E6%81%8A%E5%92%8C%E9%86%AB%E5%AD%B8%E5%A0%82%E5%BE%B5%E4%BF%A1%E9%8C%84.pdf#page=8" mimeType="application/pdf"/><zone ulx="671" uly="226" lrx="721" lry="399" xml:id="zone-line-p008-c01"/><zone ulx="613" uly="145" lrx="663" lry="336" xml:id="zone-line-p008-c02"/><zone ulx="555" uly="103" lrx="605" lry="1258" xml:id="zone-line-p008-c03"/><zone ulx="495" uly="226" lrx="545" lry="1258" xml:id="zone-line-p008-c04"/><zone ulx="435" uly="226" lrx="485" lry="1258" xml:id="zone-line-p008-c05"/><zone ulx="374" uly="226" lrx="424" lry="1258" xml:id="zone-line-p008-c06"/><zone ulx="312" uly="226" lrx="362" lry="1258" xml:id="zone-line-p008-c07"/><zone ulx="253" uly="226" lrx="303" lry="1258" xml:id="zone-line-p008-c08"/><zone ulx="193" uly="226" lrx="243" lry="1258" xml:id="zone-line-p008-c09"/><zone ulx="134" uly="226" lrx="184" lry="1258" xml:id="zone-line-p008-c10"/><zone ulx="71" uly="226" lrx="121" lry="1258" xml:id="zone-line-p008-c11"/></surface><surface n="page-9" xml:id="surface-page-9"><media url="https://upload.wikimedia.org/wikipedia/commons/d/d1/Harvard_drs_430993133_%E6%81%8A%E5%92%8C%E9%86%AB%E5%AD%B8%E5%A0%82%E5%BE%B5%E4%BF%A1%E9%8C%84.pdf#page=9" mimeType="application/pdf"/><zone ulx="743" uly="215" lrx="793" lry="1258" xml:id="zone-line-p009-c01"/><zone ulx="682" uly="215" lrx="732" lry="1258" xml:id="zone-line-p009-c02"/><zone ulx="620" uly="215" lrx="670" lry="1258" xml:id="zone-line-p009-c03"/><zone ulx="560" uly="215" lrx="610" lry="271" xml:id="zone-line-p009-c04"/></surface></facsimile><text><body><div type="preface" xml:id="preface"><ab><pb n="page-7" facs="#surface-page-7"/><lb n="1" xml:id="line-p007-c01" facs="#zone-line-p007-c01"/>序<lb n="2" xml:id="line-p007-c02" facs="#zone-line-p007-c02"/>天以生物為心。人尤以養生為重。然暑淫風寒。時多感觸。喜怒哀<lb n="3" xml:id="line-p007-c03" facs="#zone-line-p007-c03"/>樂。易失中和。是以疾病之來。最為生人之苦。此醫療之術。不可不<lb n="4" xml:id="line-p007-c04" facs="#zone-line-p007-c04"/>精益求精也。昔黃帝嘗百草以療病。和緩制方劑以活人。其法古<lb n="5" xml:id="line-p007-c05" facs="#zone-line-p007-c05"/>矣。後世失其傳。國家亦未嘗注重。學者又不克研究以幾其深。降<lb n="6" xml:id="line-p007-c06" facs="#zone-line-p007-c06"/>至於今。僅存糟粕。遇疑難之症。每至束手無策。而聽其自為死生。<lb n="7" xml:id="line-p007-c07" facs="#zone-line-p007-c07"/>良為憾事。自海禁大啟。西醫輸入中國。其療治之精奇。見之者莫<lb n="8" xml:id="line-p007-c08" facs="#zone-line-p007-c08"/>不驚而訝之。以為華扁無以過也。但西醫之至中土者無幾。散處<lb n="9" xml:id="line-p007-c09" facs="#zone-line-p007-c09"/>於一鄉一隅。以吾國幅員之廣。誠難徧及。英醫士科君。有見於是。<lb n="10" xml:id="line-p007-c10" facs="#zone-line-p007-c10"/>以拯疾為懷。獨具熱誠。首先提倡。創設醫科大學。以補吾國之所<lb n="11" xml:id="line-p007-c11" facs="#zone-line-p007-c11"/>缺。專授華人子弟。供多士之研求。拯通國之疾苦。諺云。誠可格天。<pb n="page-8" facs="#surface-page-8"/><lb n="1" xml:id="line-p008-c01" facs="#zone-line-p008-c01"/>因而上達<lb n="2" xml:id="line-p008-c02" facs="#zone-line-p008-c02"/>宸聰。仰蒙<lb n="3" xml:id="line-p008-c03" facs="#zone-line-p008-c03"/>孝欽顯皇后。賞銀萬兩。俾立始基。繼而京師各部院王大臣。各省督撫州<lb n="4" xml:id="line-p008-c04" facs="#zone-line-p008-c04"/>縣。以及貴紳巨商。亦皆相率歡迎。慨然捐助。於是宏樓蔚起。志士<lb n="5" xml:id="line-p008-c05" facs="#zone-line-p008-c05"/>遠來。舉行開學典禮時。蒙欽派大臣。那相國。臨堂祝頌。代表盛<lb n="6" xml:id="line-p008-c06" facs="#zone-line-p008-c06"/>意。各部院貴顯。及各國欽使。均同日畢集。頗極一時之盛。嗣則西<lb n="7" xml:id="line-p008-c07" facs="#zone-line-p008-c07"/>商惠助巨款者有之。自備資斧。願充義務教員者有之。各慈善會<lb n="8" xml:id="line-p008-c08" facs="#zone-line-p008-c08"/>以巨金。延聘精通醫術之士。以供本堂教授生徒者。又有之。是以<lb n="9" xml:id="line-p008-c09" facs="#zone-line-p008-c09"/>聲震全球。名播通國。舉凡有心濟世諸志士。莫不遠離鄉井。負笈<lb n="10" xml:id="line-p008-c10" facs="#zone-line-p008-c10"/>而來。自開學迄今。已幾四載。師生授受。同志觀摩。醫術日進精深。<lb n="11" xml:id="line-p008-c11" facs="#zone-line-p008-c11"/>濟濟一堂。足令人喜而不寐。觀夫此。定卜吾國醫道。必將堅立其<pb n="page-9" facs="#surface-page-9"/><lb n="1" xml:id="line-p009-c01" facs="#zone-line-p009-c01"/>基。而根於此堂也。茲特將堂中梗概。撮舉數端。俾衆咸知。本學堂<lb n="2" xml:id="line-p009-c02" facs="#zone-line-p009-c02"/>之所以成就。幾費經營。更望仁人君子。隨時解囊。源源資助。俾堂<lb n="3" xml:id="line-p009-c03" facs="#zone-line-p009-c03"/>中規模。日益宏大。造就多士。以供國家器使。而拯濟斯人。尤所冀<lb n="4" xml:id="line-p009-c04" facs="#zone-line-p009-c04"/>幸。</ab></div></body></text></TEI>